{
  "name": "imrabo-ai-orchestration",
  "displayName": "Imrabo AI Orchestration",
  "description": "Advanced AI router and benchmark extension for local and remote LLMs",
  "version": "1.0.0",
  "publisher": "your-username",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:imrabo.runLocalModel",
    "onCommand:imrabo.runRemoteModel",
    "onCommand:imrabo.generateCode",
    "onCommand:imrabo.analyzeText",
    "onCommand:imrabo.configureModels",
    "onCommand:imrabo.benchmarkPrompt",
    "onView:imrabo.panel"
  ],
  "categories": [
    "AI",
    "Programming Languages",
    "Utilities"
  ],
  "contributes": {
    "commands": [
      {
        "command": "imrabo.runLocalModel",
        "title": "Run Local AI Model (Ollama/LM Studio)"
      },
      {
        "command": "imrabo.runRemoteModel",
        "title": "Run Remote AI Model (OpenAI/Anthropic)"
      },
      {
        "command": "imrabo.generateCode",
        "title": "Generate Code with AI"
      },
      {
        "command": "imrabo.analyzeText",
        "title": "Analyze Text with AI"
      },
      {
        "command": "imrabo.configureModels",
        "title": "Configure AI Models"
      },
      {
        "command": "imrabo.benchmarkPrompt",
        "title": "Benchmark Local vs Remote Models"
      },
      {
        "command": "imrabo.openChat",
        "title": "Open Imrabo Chat"
      },
      {
        "command": "imrabo.loopTask",
        "title": "Run Looping AI Task"
      },
      {
        "command": "imrabo.explainCode",
        "title": "Explain Selected Code"
      },
      {
        "command": "imrabo.fixCode",
        "title": "Fix Selected Code"
      },
      {
        "command": "imrabo.createTests",
        "title": "Create Unit Tests"
      },
      {
        "command": "imrabo.summarizeFile",
        "title": "Summarize Current File"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Imrabo Configuration",
      "properties": {
        "imrabo.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Imrabo orchestration"
        },
        "imrabo.localModelUrl": {
          "type": "string",
          "default": "",
          "description": "Local model URL (for example, http://localhost:11434)"
        },
        "imrabo.remoteApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for remote models"
        },
        "imrabo.mode": {
          "type": "string",
          "enum": [
            "local",
            "remote",
            "hybrid"
          ],
          "default": "hybrid",
          "description": "Select the model execution mode"
        },
        "imrabo.localModelName": {
          "type": "string",
          "default": "llama3",
          "description": "Local model name or identifier"
        },
        "imrabo.localMaxTokens": {
          "type": "number",
          "default": 1024,
          "description": "Max tokens for local model responses"
        },
        "imrabo.localTemperature": {
          "type": "number",
          "default": 0.5,
          "description": "Local model temperature"
        },
        "imrabo.remoteProvider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "custom"
          ],
          "default": "openai",
          "description": "Remote model provider to use"
        },
        "imrabo.remoteModelName": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Remote model name or identifier"
        },
        "imrabo.remoteMaxTokens": {
          "type": "number",
          "default": 2048,
          "description": "Max tokens for remote model responses"
        },
        "imrabo.remoteTemperature": {
          "type": "number",
          "default": 0.7,
          "description": "Remote model temperature"
        },
        "imrabo.loopTaskCount": {
          "type": "number",
          "default": 3,
          "description": "Default repeat count for looping tasks"
        },
        "imrabo.contextLength": {
          "type": "number",
          "default": 2048,
          "description": "Maximum context length for prompt input"
        },
        "imrabo.enableMarketplace": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Imrabo skills marketplace"
        },
        "imrabo.marketplaceUrl": {
          "type": "string",
          "default": "https://example.com/imrabo-marketplace",
          "description": "Marketplace URL for skills and MCP offerings"
        },
        "imrabo.marketplaceRefreshInterval": {
          "type": "number",
          "default": 60,
          "description": "Marketplace refresh interval in minutes"
        },
        "imrabo.installedSkills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of installed marketplace skill IDs"
        },
        "imrabo.maxTokens": {
          "type": "number",
          "default": 2048,
          "description": "Maximum tokens for generic responses"
        },
        "imrabo.temperature": {
          "type": "number",
          "default": 0.7,
          "description": "Creativity temperature (0-1)"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "imrabo",
          "title": "Imrabo",
          "icon": "media/imrabo.svg"
        }
      ]
    },
    "views": {
      "imrabo": [
        {
          "id": "imrabo.panel",
          "name": "Model Benchmarks",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "imrabo.runLocalModel",
          "when": "editorTextFocus"
        },
        {
          "command": "imrabo.runRemoteModel",
          "when": "editorTextFocus"
        },
        {
          "command": "imrabo.generateCode",
          "when": "editorTextFocus"
        },
        {
          "command": "imrabo.analyzeText",
          "when": "editorTextFocus"
        },
        {
          "command": "imrabo.configureModels"
        },
        {
          "command": "imrabo.benchmarkPrompt"
        },
        {
          "command": "imrabo.openChat"
        },
        {
          "command": "imrabo.openMarketplace"
        },
        {
          "command": "imrabo.loopTask"
        },
        {
          "command": "imrabo.explainCode"
        },
        {
          "command": "imrabo.fixCode"
        },
        {
          "command": "imrabo.createTests"
        },
        {
          "command": "imrabo.summarizeFile"
        }
      ]
    },
    "keybindings": [
      {
        "command": "imrabo.generateCode",
        "key": "ctrl+alt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "imrabo.analyzeText",
        "key": "ctrl+alt+a",
        "when": "editorTextFocus"
      },
      {
        "command": "imrabo.explainCode",
        "key": "ctrl+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "imrabo.fixCode",
        "key": "ctrl+alt+f",
        "when": "editorTextFocus"
      },
      {
        "command": "imrabo.createTests",
        "key": "ctrl+alt+t",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p .",
    "watch": "tsc -w",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "mocha -r ts-node/register --timeout 10000 src/test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.2.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
